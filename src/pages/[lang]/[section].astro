---
import Name from "../../components/Name.astro";
import Base from "../../layouts/Base.astro";
import { LANGS, SEG, T, data, docName, fam, fullName, headings, lifespan, md, personUrl, url, type Lang, type Person, type Section } from "../../lib/site";

export function getStaticPaths() {
  const secs = fam().sections as readonly string[];
  return LANGS.flatMap((lang) => secs.map((s) => ({ params: { lang, section: SEG[s as Section][lang] }, props: { key: s } })));
}
const lang = Astro.params.lang as Lang;
const key = Astro.props.key as Section;
const t = T[lang];
const d = data();
const other = lang === "nl" ? "en" : "nl";
const alt = url(other, key);

// people
const sortKey = (p: Person) => `${(p.surname || "~").toLowerCase()} ${(p.given || "").toLowerCase()} ${p.estBirth ?? 9999}`;
const people = [...d.people].sort((a, b) => sortKey(a).localeCompare(sortKey(b), "nl"));
const groups = new Map<string, Person[]>();
for (const p of people) {
  const g = (p.surname || "?").replace(/^(van der|van de|van den|van|de|der|den|le|la)\s+/i, "").charAt(0).toUpperCase() || "?";
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g)!.push(p);
}

// story
const chapters = lang === "en" ? d.chapters.en || d.chapters.nl : d.chapters.nl;
const chaptersIsNl = lang === "en" && !d.chapters.en;
const toc = headings(chapters);

const titles: Record<Section, string> = { people: t.people, story: t.story, map: t.map, facts: t.facts, sources: t.sources, person: "", ask: t.ask };
---
<Base lang={lang} title={titles[key]} alt={alt} active={key} wide={key === "story"}>
  {key === "people" && (
    <>
      <h1>{t.people}</h1>
      <p class="muted">{t.stats(d.stats)}</p>
      <label class="list-search-label" for="q">{t.search.replace("…", "")}</label>
      <input type="search" id="q" placeholder={t.search} autocomplete="off" />
      <nav class="alphabet" aria-label="A-Z">{[...groups.keys()].map((g) => <a href={`#g-${g}`}>{g}</a>)}</nav>
      <p class="muted small" id="count" aria-live="polite"></p>
      <div id="list">
        {[...groups].map(([g, ps]) => (
          <section class="grp" data-grp>
            <h2 id={`g-${g}`}>{g} <a class="back-az" href="#q">A-Z</a></h2>
            <ul class="plist">
              {ps.map((p) => (
                <li data-n={`${fullName(p)} ${(p.aka || []).join(" ")}`.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "")}>
                  <a href={personUrl(lang, p.id)}><Name p={p} lang={lang} surnameFirst /></a>
                  <span class="muted"> {lifespan(p, lang)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

    </>
  )}

  {key === "story" && (
    <>
    <h1>{t.story}</h1>
    <div class="doc">
      <aside class="toc">
        <nav aria-label={lang === "nl" ? "Inhoud" : "Contents"}>
          <ul>{toc.map((h) => <li class={`l${h.level}`}><a href={`#${h.id}`}>{h.text}</a></li>)}</ul>
        </nav>
      </aside>
      <article class="prose">
        {chaptersIsNl && <p class="card muted">{t.translationPending}</p>}
        <div lang={chaptersIsNl ? "nl" : lang} set:html={md(chapters)} />
      </article>
    </div>
    </>
  )}

  {key === "sources" && (
    <article class="prose">
      <h1>{t.sources}</h1>
      <>
        <p>{lang === "nl" ? "Alle registers, kranten en familieverhalen op deze site zijn fictief. De steden bestaan; de gebeurtenissen zijn verzonnen. Bronlinks gebruiken het gereserveerde voorbeelddomein example.org." : "All registers, newspapers and family stories on this site are fictional. The towns exist; the events are invented. Source links use the reserved example.org domain."}</p>
        <ul>{[...new Set(d.people.flatMap(p => (p.sources || []).map(s => s.doc)))].map(doc => <li>{docName(doc, lang)}</li>)}</ul>
        <p>{lang === "nl" ? "Gedocumenteerd, waarschijnlijk, familieverhaal en onzeker tonen hier hoe bewijs wordt gewogen. Een mogelijke overlijdensakte staat bij Felix beschreven, maar is niet als feit aanvaard. Bij Jan blijven beide geboortedata zichtbaar." : "Documented, probable, family story and uncertain demonstrate how evidence is weighed. A possible death record is described for Felix but has not been accepted as fact. Both birth dates remain visible for Jan."}</p>
      </>
    </article>
  )}
  {key === "people" && (
  <script is:inline define:vars={{ shown: t.shown }}>
        const q = document.getElementById("q");
        const items = [...document.querySelectorAll("#list li")];
        const groups = [...document.querySelectorAll("[data-grp]")];
        const count = document.getElementById("count");
        const norm = (s) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
        q.addEventListener("input", () => {
          const terms = norm(q.value).split(/\s+/).filter(Boolean);
          let n = 0;
          for (const li of items) {
            const ok = terms.every((w) => li.dataset.n.includes(w));
            li.hidden = !ok;
            if (ok) n++;
          }
          for (const g of groups) g.hidden = !g.querySelector("li:not([hidden])");
          for (const a of document.querySelectorAll(".alphabet a")) a.hidden = document.getElementById(a.getAttribute("href").slice(1))?.closest("[data-grp]")?.hidden ?? false;
          count.textContent = terms.length ? `${n} ${shown}` : "";
        });
  </script>
  )}
</Base>
<style>
  .small { font-size: 0.85rem; }
  .plist { list-style: none; padding: 0; margin: 0; columns: 2 280px; column-gap: 32px; }
  .plist li { break-inside: avoid; padding: 2px 0; }
  .plist a { text-decoration: none; }
  .plist a:hover { text-decoration: underline; }
  .grp h2 { border-bottom: 1px solid var(--line); padding-bottom: 4px; margin-top: 1.4em; }
  .dot { font-size: 0.8em; color: var(--muted); margin-left: 4px; }
  .doc { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 40px; }
  .toc { position: sticky; top: calc(var(--head, 56px) + 16px); align-self: start; max-height: calc(100vh - 90px); overflow: auto; font-size: 0.85rem; }
  .toc ul { list-style: none; padding: 0; margin: 0; }
  .toc li { margin: 4px 0; }
  .toc .l1 { font-weight: 600; margin-top: 12px; }
  .toc .l2 { padding-left: 10px; }
  .toc a { color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
  .prose { max-width: 720px; overflow-wrap: break-word; }
  .prose :global(h2) { font-size: 1.8rem; }
  @media (pointer: coarse) {
    .plist li { padding: 5px 0; }
    }
  @media (max-width: 860px) {
    .doc { grid-template-columns: minmax(0, 1fr); }
    .toc { position: static; max-height: 260px; border: 1px solid var(--line); border-radius: 6px; padding: 8px 12px; }
  }
</style>
